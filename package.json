{
  "name": "video-autopost",
  "version": "1.0.0",
  "private": true,
  "description": "Template Remotion 9:16, render di Docker, auto-upload ke YouTube Shorts dan Instagram Reels",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:test": "remotion render src/index.ts VerticalVideo out/test.mp4",
    "typecheck": "tsc --noEmit",
    "pipeline": "node scripts/pipeline.mjs",
    "youtube:auth": "node --env-file=.env scripts/youtube-auth.mjs",
    "ig:whoami": "node --env-file=.env scripts/ig-whoami.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@googleapis/youtube": "^40.0.2",
    "@remotion/bundler": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
