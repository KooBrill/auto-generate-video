# Salin file ini menjadi .env lalu isi nilainya:  cp .env.example .env
# JANGAN commit .env dan jangan bagikan isinya ke siapa pun.

# ---------- Umum ----------
# Target default kalau job tidak menyebut "targets". Pilihan: youtube, instagram, mock
DEFAULT_TARGETS=youtube,instagram
# Jumlah job yang diproses tiap kali pipeline dijalankan
MAX_JOBS_PER_RUN=1
# Job dipindah ke jobs/failed setelah gagal sebanyak ini
MAX_ATTEMPTS=3
# Batas durasi video (detik). Video yang lebih panjang ditolak sebelum render.
MAX_VIDEO_SECONDS=90
# Jumlah thread render. Pakai 2 untuk VPS 2 vCPU.
RENDER_CONCURRENCY=2
# Isi 1 kalau file MP4 hasil render ingin disimpan di out/ setelah upload
KEEP_VIDEOS=0

# ---------- YouTube ----------
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# Didapat dari: npm run youtube:auth (jalankan di komputer lokal, sekali saja)
YT_REFRESH_TOKEN=
# private | unlisted | public.
# Selama project API belum lolos audit YouTube, video tetap terkunci private apa pun isinya.
YT_PRIVACY=private
# 22 = People & Blogs, 27 = Education, 24 = Entertainment
YT_CATEGORY_ID=22

# ---------- Instagram Reels ----------
# instagram = Business Login for Instagram (tanpa Facebook Page, video lewat URL publik/S3/R2)
# facebook  = Facebook Login for Business (butuh Facebook Page, video diunggah langsung ke Meta)
IG_LOGIN_TYPE=instagram
# Token long-lived (60 hari). Diperbarui otomatis oleh pipeline untuk IG_LOGIN_TYPE=instagram.
IG_ACCESS_TOKEN=
# ID akun Instagram. Untuk login type "instagram" bisa dicek dengan: npm run ig:whoami
IG_USER_ID=
IG_API_VERSION=v26.0
# Isi 1 untuk menandai video sebagai konten buatan AI di Instagram
IG_AI_GENERATED=0

# ---------- Penyimpanan sementara (hanya untuk IG_LOGIN_TYPE=instagram) ----------
# Contoh Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com  (region: auto)
# Contoh AWS S3: kosongkan S3_ENDPOINT, isi S3_REGION (misal ap-southeast-1)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Opsional: kalau bucket punya domain publik, isi di sini. Kalau kosong dipakai presigned URL.
S3_PUBLIC_BASE_URL=

# ---------- Notifikasi Telegram (opsional) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
